# Dependencies and build output — rebuilt from package-lock.json
node_modules/
dist/

# Local settings: holds real share paths, and belongs in %APPDATA%\Bubbler+ now
config.json

# The old third-party symbol font, replaced by SimpleGeoDim (OFL, committed).
# Still ignored, so a stray local copy can never enter the history.
assets/Verisurf.ttf
# The logo used to be read from here; it lives in the data folder now.
assets/logo.png

# Stray local data, in case an old copy is still lying around the dev folder
.bubbler-index/
recents.json
recovery.insp
recovery.json

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# Python caches, from tools/icon/build.py and the e2e harness
__pycache__/
*.pyc

# Scratch
*.log
*.bak
*.tmp
# Half-written files from the app's atomic saves, if a crash leaves one
*.bubbler-tmp

# Private working notes and tools
PLAN.md
MEMORY.md
comment-style.md
tools/e2e/
